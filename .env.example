# --- Datenbank (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://dienstplan:dienstplan@localhost:5432/dienstplan?schema=public"

# --- NextAuth ---------------------------------------------------------------
# Zufälligen Wert erzeugen: npx auth secret   oder   openssl rand -base64 32
AUTH_SECRET="bitte-aendern"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Microsoft Entra ID (Firmen-SSO). Leer lassen, solange nicht eingerichtet.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Demo-Anmeldung (Benutzer wählen ohne Passwort) – NUR für Test-/Demosysteme!
AUTH_DEMO_LOGIN=true
